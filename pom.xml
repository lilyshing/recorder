<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.airecorder</groupId>
    <artifactId>recorder</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Screen Recorder</name>
    <description>屏幕录像工具，支持有界面/无界面模式，输出 MP4，提供 REST API</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javacv.version>1.5.10</javacv.version>
        <main.class>com.airecorder.RecorderApplication</main.class>
    </properties>

    <dependencies>
        <!-- JavaCV: 封装 FFmpeg，用于 MP4/H.264 视频编码 -->
        <!-- 仅引入 Windows x86_64 原生库以减小体积；如需全平台分发可改回 javacv-platform -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacv</artifactId>
            <version>${javacv.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>${javacv.version}</version>
            <classifier>windows-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>ffmpeg</artifactId>
            <version>6.1.1-1.5.10</version>
            <classifier>windows-x86_64</classifier>
        </dependency>
        <!-- 本地升级客户端 jar：system 作用域仅保证编译期可见；
             打包时由 maven-dependency-plugin 解压到 target/classes，再由 shade 打入 fat jar -->
        <dependency>
            <groupId>com.aipro</groupId>
            <artifactId>upgrade-client</artifactId>
            <version>1.0.0</version>
            <systemPath>${project.basedir}/lib/upgrade-client.jar</systemPath>
            <scope>system</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>recorder</finalName>
        <plugins>
            <!-- 把 system 作用域的 upgrade-client.jar 直接解压到 target/classes，
                 使其作为项目输出被 maven-shade-plugin 打入 fat jar（shade 默认不包含 system 依赖） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>unpack-upgrade-client</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <unzip src="${project.basedir}/lib/upgrade-client.jar"
                                       dest="${project.build.outputDirectory}">
                                    <patternset>
                                        <exclude name="META-INF/MANIFEST.MF"/>
                                    </patternset>
                                </unzip>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 打成可执行 fat jar，包含所有依赖与原生库 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
